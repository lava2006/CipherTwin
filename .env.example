# ==============================================================================
# CipherTwin Unified Platform Environment Configuration (.env.example)
# Copy this file to .env and adjust variables for your target deployment.
# ==============================================================================

# --- Core Application & Security Settings ---
APP_NAME=CipherTwin
DEBUG=false
SECRET_KEY=change-me-in-production-please-make-this-long-and-cryptographically-random
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# --- Primary Database (SQLite / Postgres) ---
DATABASE_URL=sqlite:///./data/ciphertwin.db

# --- Real-Time Messaging & Telemetry Broker (RabbitMQ) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_QUEUE=ciphertwin_telemetry
RABBITMQ_EXCHANGE=ciphertwin_events
RABBITMQ_ROUTING_KEY=telemetry.event

# --- Digital Twin Graph Database (Neo4j) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=ciphertwin

# --- High-Interaction Cowrie Honeypot Integration ---
COWRIE_ENABLED=true
COWRIE_LOG_PATH=./data/cowrie/cowrie.json
COWRIE_SSH_PORT=2222
COWRIE_TELNET_PORT=2223

# --- Adaptive Deception Engine Mode ---
# Modes: SIMULATED (internal in-memory/DB decoys), LIVE (orchestrated with Cowrie), OFF
DECEPTION_MODE=SIMULATED

# --- Background Telemetry Simulation ---
ENABLE_SIMULATION=true
TELEMETRY_INTERVAL_SECONDS=2.5

# --- Machine Learning Engine ---
MODEL_PATH=./models/risk_pipeline.joblib
