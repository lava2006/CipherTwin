# LOCAL DEVELOPMENT ONLY. Replace every placeholder before shared/production use.
APP_NAME=CipherTwin
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_ADMIN_PASSWORD
SEED_ANALYST_PASSWORD=REPLACE_WITH_A_UNIQUE_ANALYST_PASSWORD
SEED_SOC_LEAD_PASSWORD=REPLACE_WITH_A_UNIQUE_SOC_LEAD_PASSWORD
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost","http://localhost:80"]
DATABASE_URL=sqlite:///./data/ciphertwin.db
ENABLE_SIMULATION=true
TELEMETRY_INTERVAL_SECONDS=1.0

# Local Docker Compose services
RABBITMQ_ENABLED=true
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=ciphertwin_local
RABBITMQ_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_RABBITMQ_PASSWORD
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=ciphertwin.telemetry
RABBITMQ_DLQ=ciphertwin.telemetry.dlq
RABBITMQ_EXCHANGE=ciphertwin.events

NEO4J_ENABLED=true
NEO4J_URL=http://localhost:7474
NEO4J_BOLT_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_NEO4J_PASSWORD

COWRIE_ENABLED=true
COWRIE_LOG_PATH=./data/cowrie/log/cowrie/cowrie.json
DECEPTION_MODE=COWRIE

DECOY_WEB_PUBLIC_URL=http://127.0.0.1:8081
